# ===================================================
# Application Configuration
# ===================================================
PORT=3000
NODE_ENV=development

# ===================================================
# Storage Settings (Local file system)
# ===================================================
# Đường dẫn lưu trữ file (tương đối so với thư mục gốc hoặc tuyệt đối)
STORAGE_PATH=./storage
RAW_STORAGE_PATH=./storage/raw
OUTPUT_STORAGE_PATH=./storage/outputs

# ===================================================
# Database (PostgreSQL + Prisma)
# ===================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password123
POSTGRES_DB=video_processing_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:password123@localhost:5432/video_processing_db?schema=public"

# ===================================================
# Message Broker (RabbitMQ)
# ===================================================
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_URL="amqp://guest:guest@localhost:5672"

# Queue Name
VIDEO_PROCESSING_QUEUE=video_processing_queue

